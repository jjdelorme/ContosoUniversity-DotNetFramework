@model Instructor

@{
    ViewData["Title"] = "Edit";
    var courses = ViewData["Courses"] as List<AssignedCourseData>;
}

<h2>Edit</h2>

<h4>Instructor</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.ID">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            
            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FirstMidName" class="form-label"></label>
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HireDate" class="form-label"></label>
                <input asp-for="HireDate" class="form-control" />
                <span asp-validation-for="HireDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OfficeAssignment.Location" class="form-label"></label>
                <input asp-for="OfficeAssignment.Location" class="form-control" />
                <span asp-validation-for="OfficeAssignment.Location" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Courses</label>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <tr>
                            @{
                                int cnt = 0;
                                if (courses != null)
                                {
                                    foreach (var course in courses)
                                    {
                                        if (cnt++ % 3 == 0)
                                        {
                                            @:</tr><tr>
                                        }
                                        @:<td>
                                            <input type="checkbox"
                                                   name="selectedCourses"
                                                   value="@course.CourseID"
                                                   @(Html.Raw(course.Assigned ? "checked=\"checked\"" : "")) />
                                            @course.CourseID @:&nbsp; @course.Title
                                        @:</td>
                                    }
                                }
                            @:</tr>
                        }
                    </table>
                </div>
            </div>
                            
            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
