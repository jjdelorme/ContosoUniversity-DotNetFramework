@model InstructorIndexData

@{
    ViewData["Title"] = "Instructors";
    var instructorID = ViewData["InstructorID"] as int?;
    var courseID = ViewData["CourseID"] as int?;
}

<h2>Instructors</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Last Name</th>
            <th>First Name</th>
            <th>Hire Date</th>
            <th>Office</th>
            <th>Courses</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Instructors)
        {
            string selectedRowClass = (item.ID == instructorID) ? "table-active" : "";
            <tr class="@selectedRowClass">
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstMidName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HireDate)
                </td>
                <td>
                    @if (item.OfficeAssignment != null)
                    {
                        @item.OfficeAssignment.Location
                    }
                </td>
                <td>
                    @if (item.Courses != null)
                    {
                        foreach (var course in item.Courses)
                        {
                            Write(course.CourseID + " " + course.Title);
                            <br />
                        }
                    }
                </td>
                <td>
                    <a asp-action="Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Courses != null)
{
    <h3 class="mt-4">Courses Taught by Selected Instructor</h3>
    <table class="table table-sm">
        <thead>
            <tr>
                <th></th>
                <th>Number</th>
                <th>Title</th>
                <th>Department</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Courses)
            {
                string selectedRowClass = (item.CourseID == courseID) ? "table-active" : "";
                <tr class="@selectedRowClass">
                    <td>
                        <a asp-action="Index" asp-route-id="@instructorID" asp-route-courseID="@item.CourseID">Select</a>
                    </td>
                    <td>
                        @item.CourseID
                    </td>
                    <td>
                        @item.Title
                    </td>
                    <td>
                        @item.Department?.Name
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Enrollments != null)
{
    <h3 class="mt-4">Students Enrolled in Selected Course</h3>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Enrollments)
            {
                <tr>
                    <td>
                        @item.Student?.FullName
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Grade)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
